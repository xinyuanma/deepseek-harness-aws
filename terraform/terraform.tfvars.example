# AWS deployment
aws_region       = "eu-north-1"
instance_type    = "t3.small"
root_volume_size = 20

# Source code deployed and built on EC2
repository_url = "https://github.com/xinyuanma/deepseek-harness-aws.git"
repository_ref = "main"

# AWS Secrets Manager
secret_name = "deepseek-harness/deepseek-api-key"