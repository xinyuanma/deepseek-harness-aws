#cloud-config

package_update: true

packages:
  - docker.io
  - docker-compose-v2
  - curl
  - unzip
  - git

runcmd:
  - systemctl enable docker
  - systemctl start docker

    # Install AWS CLI v2
  - curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  - unzip -q /tmp/awscliv2.zip -d /tmp
  - /tmp/aws/install
  - rm -rf /tmp/aws /tmp/awscliv2.zip

    # Deploy DeepSeek Harness application
  - mkdir -p /opt/deepseek-harness-aws
  - git clone --branch ${repository_ref} --single-branch ${repository_url} /opt/deepseek-harness-aws

    # Fetch secret and start Harness
  - |
    set -e

    for attempt in 1 2 3 4 5 6; do
      if DEEPSEEK_API_KEY="$(
        aws secretsmanager get-secret-value \
          --secret-id ${secret_name} \
          --query SecretString \
          --output text
      )"; then
        export DEEPSEEK_API_KEY
        break
      fi

      echo "Secret not available yet; retrying in 10 seconds..."
      sleep 10
    done

    if [ -z "$${DEEPSEEK_API_KEY:-}" ]; then
      echo "Failed to retrieve DeepSeek API key after retries."
      exit 1
    fi

    cd /opt/deepseek-harness-aws/app

    docker compose up -d --build

    unset DEEPSEEK_API_KEY