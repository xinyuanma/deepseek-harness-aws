#cloud-config

package_update: true

packages:
  - docker.io
  - docker-compose-v2
  - curl
  - unzip
  - git

runcmd:
  - systemctl enable docker
  - systemctl start docker

    # Install AWS CLI v2
  - curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  - unzip -q /tmp/awscliv2.zip -d /tmp
  - /tmp/aws/install
  - rm -rf /tmp/aws /tmp/awscliv2.zip

    # Deploy DeepSeek Harness application
  - mkdir -p /opt/deepseek-harness-aws
  - git clone --branch ${repository_ref} --single-branch ${repository_url} /opt/deepseek-harness-aws

    # Fetch secret and start Harness
  - |
    set -e

    VOLUME_ID="${data_volume_id}"
    VOLUME_SERIAL="$(printf '%s' "$VOLUME_ID" | tr -d '-')"
    DEVICE=""

    for attempt in $(seq 1 30); do
      DEVICE="$(
        lsblk -dn -o NAME,SERIAL |
        awk -v serial="$VOLUME_SERIAL" '$2 == serial { print "/dev/" $1; exit }'
      )"

      if [ -n "$DEVICE" ]; then
        echo "Persistent EBS volume found at $DEVICE"
        break
      fi

      echo "Persistent EBS volume not attached yet; retrying in 5 seconds..."
      sleep 5
    done

    if [ -z "$DEVICE" ]; then
      echo "Failed to find persistent EBS volume."
      exit 1
    fi

    if ! blkid "$DEVICE" >/dev/null 2>&1; then
      echo "No filesystem found; formatting persistent volume as ext4."
      mkfs.ext4 -F "$DEVICE"
    else
      echo "Existing filesystem found; skipping format."
    fi

    mkdir -p /mnt/dsh-data

    UUID="$(blkid -s UUID -o value "$DEVICE")"

    if ! grep -q "UUID=$UUID " /etc/fstab; then
      echo "UUID=$UUID /mnt/dsh-data ext4 defaults,nofail 0 2" >> /etc/fstab
    fi

    mount -a

    mkdir -p /mnt/dsh-data/dsh
    mkdir -p /mnt/dsh-data/workspace
    mkdir -p /mnt/dsh-data/discord-sessions

    # Fetch DeepSeek API key
    DEEPSEEK_API_KEY=""

    for attempt in 1 2 3 4 5 6; do
      if DEEPSEEK_API_KEY="$(
        aws secretsmanager get-secret-value \
          --secret-id ${secret_name} \
          --query SecretString \
          --output text 2>/dev/null
      )"; then
        break
      fi

      echo "DeepSeek API key not available yet; retrying in 10 seconds..."
      sleep 10
    done

    if [ -n "$${DEEPSEEK_API_KEY:-}" ]; then
      echo "DeepSeek API key found in Secrets Manager."
      export DEEPSEEK_API_KEY
    else
      echo "No DeepSeek API key found in Secrets Manager."
      echo "Harness will start without an API key."
      echo "Configure your API key in the Web UI after startup."
    fi

    # Fetch Discord bot token
    DISCORD_BOT_TOKEN=""

    for attempt in 1 2 3 4 5 6; do
      if DISCORD_BOT_TOKEN="$(
        aws secretsmanager get-secret-value \
          --secret-id ${discord_secret_name} \
          --query SecretString \
          --output text 2>/dev/null
      )"; then
        break
      fi

      echo "Discord bot token not available yet; retrying in 10 seconds..."
      sleep 10
    done

    if [ -n "$${DISCORD_BOT_TOKEN:-}" ]; then
      echo "Discord bot token found in Secrets Manager."
      export DISCORD_BOT_TOKEN
    else
      echo "No Discord bot token found in Secrets Manager."
      echo "Discord integration will not be able to authenticate."
    fi

    export DSH_DATA_ROOT=/mnt/dsh-data

    cd /opt/deepseek-harness-aws/app
    docker compose up -d --build

    unset DEEPSEEK_API_KEY
    unset DISCORD_BOT_TOKEN
    unset DSH_DATA_ROOT